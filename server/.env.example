# ---------- Required ----------
# PostgreSQL connection string (Neon / Supabase / Render Postgres / local)
DATABASE_URL=postgresql://gradelens:gradelens@localhost:5432/gradelens
# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 64 hex characters, encrypts Google tokens in the DB. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Public URL of this server (Google redirects to PUBLIC_API_URL/api/auth/google/callback)
PUBLIC_API_URL=http://localhost:8080

# ---------- Google sign-in + Drive (Google Cloud Console → OAuth client, type "Web application") ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow these email domains to sign in (comma separated), e.g. gehu.ac.in
ALLOWED_EMAIL_DOMAINS=

# ---------- Claude API ----------
ANTHROPIC_API_KEY=
# Models (defaults shown). Haiku grades everything, Sonnet re-checks unclear submissions and writes answer keys.
GRADING_MODEL=claude-haiku-5-5
REVIEW_MODEL=claude-sonnet-5-5
KEY_MODEL=claude-sonnet-5-5
# Parallel AI calls. Raise it when your Claude API tier allows more requests per minute.
EVAL_CONCURRENCY=5
# Below this AI confidence a submission goes to "Needs Review" (and gets a second opinion)
ESCALATION_CONFIDENCE=0.7
USD_TO_INR=86

# ---------- Optional ----------
PORT=8080
# Web app URL when it is hosted separately from this server (default: PUBLIC_API_URL)
FRONTEND_URL=
# Extra allowed browser origins, comma separated
EXTRA_CORS_ORIGINS=
# Local testing only: shows "Continue in demo mode" on the login screen. Never enable in production.
DEV_LOGIN=false
NODE_ENV=development
