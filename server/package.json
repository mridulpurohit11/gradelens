{
  "name": "gradelens-server",
  "version": "1.0.0",
  "description": "GradeLens backend API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
